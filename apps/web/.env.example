# URL publica da API (apps/api). Precisa do prefixo NEXT_PUBLIC_ porque e
# lida pelo codigo que roda NO NAVEGADOR (lib/api.ts, components/auth-context.tsx).
#
# ATENCAO: no Next.js, variaveis NEXT_PUBLIC_ sao embutidas no bundle em tempo
# de BUILD, nao lidas em runtime. Mudar este valor na Vercel exige um novo
# deploy pra fazer efeito - trocar a variavel e reiniciar nao basta.
#
# Em desenvolvimento pode ficar ausente (o default e http://localhost:3001).
# Em producao: NEXT_PUBLIC_API_URL="https://concilion-crm-api.onrender.com"
# NEXT_PUBLIC_API_URL="http://localhost:3001"
