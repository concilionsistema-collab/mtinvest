    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
