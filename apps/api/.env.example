# Usado pela aplicacao em runtime - role sem privilegio de superusuario,
# para que a Row-Level Security (DEC-TEC-001) seja realmente aplicada.
DATABASE_URL="postgresql://crm_app:crm_app@localhost:5432/crm_imobiliario?schema=public"

# Usado apenas para rodar "npx prisma migrate deploy" (superusuario, ver db/init/).
# npm run prisma:migrate usa esta variavel automaticamente.
MIGRATE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_imobiliario?schema=public"

PORT=3001

# US-002/US-003 (EPIC-01): segredo para assinar/verificar o JWT de sessao.
# Gere um valor proprio, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-gerado-localmente"

# US-111 (ART-010 secao 21, DEC-NEG-017 PENDENTE): a formula de multa
# rescisoria e uma HIPOTESE TECNICA, nao validada juridicamente. Deixe
# AUSENTE (ou "false") em qualquer ambiente real. So defina "true" em
# teste/homologacao, sabendo que a formula pode nao corresponder a
# legislacao de locacao aplicavel.
# LOCACAO_MULTA_RESCISORIA_HABILITADA="true"
