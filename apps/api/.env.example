# Usado pela aplicacao em runtime - role sem privilegio de superusuario,
# para que a Row-Level Security (DEC-TEC-001) seja realmente aplicada.
DATABASE_URL="postgresql://crm_app:crm_app@localhost:5432/crm_imobiliario?schema=public"

# Usado apenas para rodar "npx prisma migrate deploy" (superusuario, ver db/init/).
# npm run prisma:migrate usa esta variavel automaticamente.
MIGRATE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_imobiliario?schema=public"

PORT=3001

# Origens do portal autorizadas a chamar a API pelo navegador (CORS).
# Varias podem ser separadas por virgula. Em desenvolvimento pode ficar
# ausente (o default e http://localhost:3000); em producao (NODE_ENV=production)
# a aplicacao se RECUSA a subir sem esta variavel - ver src/main.ts.
# Ex. em producao: CORS_ORIGIN="https://concilion-crm.vercel.app"
# CORS_ORIGIN="http://localhost:3000"

# US-002/US-003 (EPIC-01): segredo para assinar/verificar o JWT de sessao.
# Gere um valor proprio, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-gerado-localmente"

# Protege GET /scheduler/varredura (gatilho do Vercel Cron Job - ver
# apps/api/vercel.json e scheduler.controller.ts). So necessario em
# producao (NODE_ENV=production) - a aplicacao se RECUSA a subir sem esta
# variavel nesse caso, mesma logica de CORS_ORIGIN. Gere com o mesmo
# comando do JWT_SECRET acima.
# CRON_SECRET="troque-por-um-segredo-gerado-localmente"

# Onboarding self-service (POST /tenants) + cobranca (BillingModule).
# Sem estas 3 variaveis a API sobe normalmente (nao sao como JWT_SECRET/
# DATABASE_URL, opcionais de proposito) - so os endpoints /billing/checkout
# e /billing/webhook respondem com erro claro ate serem configuradas.
# STRIPE_SECRET_KEY: chave secreta da conta Stripe (dashboard > Developers > API keys).
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PRICE_ID: id do preco recorrente (Product > Pricing) que representa a assinatura mensal do CRM.
# STRIPE_PRICE_ID="price_..."
# STRIPE_WEBHOOK_SECRET: gerado ao criar o webhook endpoint no dashboard Stripe apontando pra POST /billing/webhook.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# URL publica do FRONT-END (nao da API) - usada só para montar os links de
# volta do Stripe Checkout (success_url/cancel_url, ver BillingService).
# Em desenvolvimento pode ficar ausente (default http://localhost:3000).
# APP_URL="https://mtinvest-web.vercel.app"

# US-111 (ART-010 secao 21, DEC-NEG-017 PENDENTE): a formula de multa
# rescisoria e uma HIPOTESE TECNICA, nao validada juridicamente. Deixe
# AUSENTE (ou "false") em qualquer ambiente real. So defina "true" em
# teste/homologacao, sabendo que a formula pode nao corresponder a
# legislacao de locacao aplicavel.
# LOCACAO_MULTA_RESCISORIA_HABILITADA="true"
